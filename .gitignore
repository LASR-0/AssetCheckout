
# ----------------------------------------------------------------------------
# Dependencies
# ----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
 
# ----------------------------------------------------------------------------
# Environment files
# ----------------------------------------------------------------------------
# Real .env files are local-only. Use .env.example as the template for
# contributors and self-hosters.
.env
.env.local
.env.*.local
*.local
 
# Allow the example templates to be tracked
!.env.example
 
# ----------------------------------------------------------------------------
# Build output
# ----------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
 
# ----------------------------------------------------------------------------
# Prisma — generated client
# ----------------------------------------------------------------------------
# The Prisma client is generated from schema.prisma at install time; it
# shouldn't be tracked. Migrations DO need to be tracked (they're the
# canonical record of schema evolution).
backend/generated/
 
# ----------------------------------------------------------------------------
# SQLite databases (local dev only)
# ----------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ----------------------------------------------------------------------------
# Quote documents (local dev only)
# ----------------------------------------------------------------------------
# QUOTES_DIR defaults to ./data/quotes and the server creates it at startup,
# so a plain `pnpm dev` leaves this behind. These are supplier quotes — real
# ones name real prices — and belong on the deployment's persistent volume,
# never in the repository.
backend/data/

# ----------------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
 
# ----------------------------------------------------------------------------
# Editor / OS noise
# ----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
 
# Visual Studio (Windows) project files — unlikely but harmless to exclude
*.suo
*.ntvs*
*.njsproj
*.sln
 
# Windows zone-identifier metadata (WSL artifact when downloading files)
*:Zone.Identifier
 
# Explicitly track this file despite .vscode/ being ignored — it shares
# recommended extensions with contributors.
!.vscode/extensions.json
 
# ----------------------------------------------------------------------------
# Misc — internal-only scratch
# ----------------------------------------------------------------------------
# The misc/ folder is for project notes / drafts that probably shouldn't be
# public. If you want to track specific subfolders, override with !misc/foo/.
misc/

#-----------------------------------------------------------------------------
# CERTS - certs have been added to bypass SSL errors for SMTP testing
#-----------------------------------------------------------------------------
backend/cert/

#-----------------------------------------------------------------------------
# SCRIPTS - scripts excluded / dev only no use in production
#-----------------------------------------------------------------------------
# The contents are ignored, NOT the directory itself. Git cannot re-include a
# file whose parent directory is excluded, so `backend/src/scripts` on its own
# would make the exception below impossible.
backend/src/scripts/*

# ...except the troubleshooting content tooling, which is not a dev scratch
# script. Reseeding and exporting the article library are the documented way to
# manage content now that it lives in the database, and an untracked copy would
# be missing for anyone else and gone on a fresh clone.
!backend/src/scripts/*Troubleshooting*.ts

#-----------------------------------------------------------------------------
# PROTOTYPE - Phase 5 troubleshooting design mockup, reference only
#-----------------------------------------------------------------------------
# Structural reference for the troubleshooting page, not shipped code. Delete
# the folder and this rule together once the page is built.
prototype/
miramare-dark-theme.css