generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma_client"
}

datasource db {
  provider = "sqlite"
}

/* ===================== REQUESTS ===================== */
model Request {
  id             Int      @id @default(autoincrement())

  userId         Int

  userName       String

  categoryId     Int
  categoryName   String

  requestKind    RequestKind  @default(ASSET)
  requestType    RequestType
  status         RequestStatus @default(PENDING)

  reason         String?
  // Free text: "what model do you have in mind?". Shared by asset and
  // accessory requests, captured alongside the reason on a non-standard
  // request. Null on standard requests, which never offer the field.
  preferredModel String?
  manager        String?
  managerId      Int

  callText       Boolean @default(false)
  newNumber      Boolean @default(false) //this will be replaced after we clean out where the value is used on the frontend
  needsData            Boolean       @default(false)
  numberOption         NumberOption?
  accessoryOption      String?
  reuseNumberFromEmail String?
  reuseNumberPhone     String?

  collectionReadyAt  DateTime?
  shippedAt          DateTime?
  receivedAt         DateTime?
  needsShipping      Boolean   @default(false)
  locationMissing    Boolean   @default(false)
  trackingCode       String?
  trackingUrl        String?

  syncedToSharepointAt DateTime?

  /// Exactly-once marker for the CAPEX purchase log, on the same terms as
  /// syncedToSharepointAt above: stamped only after a successful send, so a
  /// failure leaves it null and the job retries. Set only on non-standard
  /// ACCESSORY requests whose accepted quote exceeded the threshold — every
  /// other row stays null forever.
  loggedToCapexAt      DateTime?

  reminderStage      Int       @default(0)

  approvedBy        String?
  approvedAt        DateTime?
  adminApprovedBy   String?
  adminApprovedAt   DateTime?
  rejectedBy        String?
  rejectedAt        DateTime?

  modelRequest   ModelRequest?
  correctionDetail CorrectionDetail?
  quoteDetail    QuoteDetail?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/* ===================== MODEL REQUESTS ===================== */
model ModelRequest {
  id             Int      @id @default(autoincrement())

  requestId      Int      @unique
  request        Request  @relation(fields: [requestId], references: [id])

// Working buffer for the admin's Create Model form. Persisted on partial submits
// so the form can resume if Snipe-IT creation fails midway. Populated by admin
// during model creation, not by the requester.
  manufacturer   String?
  modelName      String?
  modelNumber    String?
  price          Float?

  linkedAssetId  Int?
  snipeModelId   Int?
  snipeAccessoryId  Int?

  status         ModelRequestStatus @default(PENDING)
  assetReady     Boolean            @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/* ===================== SETTINGS ===================== */
model Setting {
  key         String   @id
  value       String   // JSON-serialized or plain string depending on key
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?  // actor's email at time of last write
}

/* ===================== BACKGROUND JOBS ===================== */

model BackgroundJob {
  id            Int       @id @default(autoincrement())
  type          JobType
  status        JobStatus @default(Pending)
  payload       String?   // JSON string
  resultSummary String?   // JSON string
  errorMessage  String?
  scheduledAt   DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  createdAt     DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([type])
}

/* ===================== Feedback ===================== */

model Feedback {
  id                 Int      @id @default(autoincrement())
  improvedRequesting String
  improvesItOverall  String
  comments           String?
  createdAt          DateTime @default(now())
}

/* ===================== CORRECTIONS ===================== */
// Correction-specific data, hung off Request 1:1 exactly as ModelRequest is,
// rather than adding half a dozen more nullable columns to Request that would
// be null for the overwhelming majority of rows.
//
// A correction never provisions anything: it enters the workflow already at
// APPROVED (there is no manager stage), and an admin either applies it to
// Snipe or rejects it.
model CorrectionDetail {
  id             Int      @id @default(autoincrement())

  requestId      Int      @unique
  request        Request  @relation(fields: [requestId], references: [id])

  correctionKind CorrectionKind
  /// Whether the thing being corrected is an asset or an accessory. Separate
  /// from Request.requestKind, which is CORRECTION for every row here.
  subjectKind    CorrectionSubject

  /// The Snipe record the correction is about, where one exists — null for an
  /// unlogged item, which by definition has no record yet.
  snipeRecordId  Int?
  /// Free text from the requester. Resolved manually by an admin; volume is
  /// low and bursty, so there is no need to pre-structure it.
  description    String
  /// The serial as the user reports it — either read off an unlogged item, or
  /// a correction to what's recorded. Always optional: accessories frequently
  /// have no serial at all, and users often can't find one.
  serial         String?

  /// WRONG_MODEL only: what the model actually is, in the user's words.
  correctedModel String?

  /// WRONG_MODEL only: which detail is wrong — serial, model, or something
  /// the user describes instead.
  wrongField     WrongField?

  /// NO_LONGER_HELD only: why it's gone.
  noLongerHeldReason NoLongerHeldReason?

  /// Why an approved correction could not be written to Snipe. Set when the
  /// admin approved but the write failed or could not be attempted; the
  /// Request deliberately STAYS at APPROVED so the correction remains in the
  /// admin queue and can be retried, rather than being marked COMPLETED with
  /// Snipe untouched. Cleared on a successful apply.
  applyError     String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/* ===================== QUOTES ===================== */
// Quote-specific data, hung off Request 1:1 exactly as ModelRequest and
// CorrectionDetail are. Every column here is null on the overwhelming majority
// of rows — only non-standard ACCESSORY requests ever get one — so they stay
// off Request.
//
// Quotes exist because IT does not pay for non-standard accessories: the
// requesting user's department does. That makes the cost the manager's to
// commit to, which is why there is a document, a figure, and an outcome to
// record. Assets are deliberately excluded — IT buys those, and the tier
// average in the asset-details step is all the cost signal that side needs.
//
// One quote per request, by decision: a quote cannot be revised or re-sent
// once it has gone to the manager. If the figure was wrong, the manager
// rejects and the request ends. That is why this is 1:1 with no history table.
model QuoteDetail {
  id             Int      @id @default(autoincrement())

  requestId      Int      @unique
  request        Request  @relation(fields: [requestId], references: [id])

  /// What the supplier quoted, in dollars. Required — this is the figure the
  /// manager commits to, and the one the over-$1k purchase logging reads.
  amount         Float
  /// Who the quote is from. Named in the email so the manager knows who they
  /// are committing to buy from.
  supplier       String
  /// The supplier's own quote identifier. Optional: plenty of quotes arrive as
  /// a bare emailed price with no reference to speak of.
  reference      String?

  /// The quote document. Required — a figure typed into a form is not a quote.
  /// The file itself lives on disk under QUOTES_DIR rather than in the DB;
  /// `documentPath` is the leaf name within that directory, never a full path,
  /// so the storage root can move without a data migration and a stored value
  /// can never escape the directory.
  documentName   String
  documentMime   String
  documentPath   String

  status         QuoteStatus @default(SENT)

  sentBy         String
  sentAt         DateTime @default(now())

  respondedBy    String?
  respondedAt    DateTime?
  /// True when an admin accepted or rejected in the manager's place, the same
  /// standing-in an admin can already do at the first approval. Worth its own
  /// column rather than inferring it from respondedBy: this is the record of
  /// who committed a department's budget.
  respondedOnBehalf Boolean @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/* ===================== ENUMS ===================== */
enum RequestType {
  STANDARD
  NON_STANDARD
  // Corrections are not a spec level, but requestType is non-nullable and
  // every provisioning branch tests it for STANDARD or NON_STANDARD. Giving
  // corrections their own value means those branches exclude them by
  // construction rather than by remembering a guard — including the admin
  // fulfilment branch in approveRequest, which would otherwise check hardware
  // out of Snipe, and the non-standard row treatment in the requests table.
  CORRECTION
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ModelRequestStatus {
  PENDING
  APPROVED
  COMPLETED
}

enum NumberOption {
  NEW
  REUSE
  NONE
}

enum JobType {
  SEND_REQUEST_NOTIFICATION
  SYNC_REQUEST_TO_SHAREPOINT
  REFRESH_CATEGORIES_CACHE
  REFRESH_PRICES_CACHE
  CLEANUP_STALE_REQUESTS
  CLEANUP_ORPHAN_SNIPE_MODELS
  PURGE_OLD_JOB_HISTORY
  REMIND_SHIPPED_REQUESTS
  REFRESH_ACCESSORIES_CACHE
  /// Lodge a purchase over the threshold in the CAPEX ledger. Event-driven,
  /// not scheduled: enqueued the moment a manager accepts a quote, so it needs
  /// no cron expression and cannot go the way of a schedule that was never
  /// registered.
  LOG_CAPEX_PURCHASE
}

enum JobStatus {
  Pending
  Running
  Completed
  Failed
}

/// Where a quote sits with the manager. Deliberately NOT a RequestStatus: the
/// request stays APPROVED throughout, and "waiting on the manager's answer" is
/// derived from this the same way the accessory quantity-wait is derived from
/// ModelRequest.status + assetReady. Rejection is terminal and drives the
/// Request to REJECTED through the ordinary rejection path.
enum QuoteStatus {
  SENT
  ACCEPTED
  REJECTED
}

enum RequestKind {
  ASSET
  ACCESSORY
  // A request to correct the Snipe record rather than to provision anything.
  // What the correction is ABOUT (an asset or an accessory) lives on
  // CorrectionDetail.subjectKind, not here.
  CORRECTION
}

enum CorrectionKind {
  /// The user has something that isn't recorded against them.
  UNLOGGED
  /// Something is recorded against them that they no longer have.
  NO_LONGER_HELD
  /// The record exists but names the wrong model.
  WRONG_MODEL
}

enum CorrectionSubject {
  ASSET
  ACCESSORY
}

/// Why the user no longer has something recorded against them. Optional, but
/// it's the difference between an admin knowing what to do with the record and
/// having to chase the requester.
/// Which recorded detail the user says is wrong. WRONG_MODEL is the kind;
/// this says which field within it, so a serial-only correction doesn't have
/// to pretend the model is wrong.
enum WrongField {
  SERIAL
  MODEL
  OTHER
}

enum NoLongerHeldReason {
  RETURNED
  LOST
  SWAPPED
  GAVE_AWAY
  OTHER
}
/* ===================== TROUBLESHOOTING ANALYTICS ===================== */
// Whether the troubleshooting library actually deflects tickets, recorded as
// an event log rather than four counters — a counter can only ever answer the
// question it was created for, and the useful questions here aren't all known
// yet.
//
// ANONYMOUS, BUT GROUPED. No name or email is stored. `sessionId` is a random
// value minted per visit and thrown away with the tab, and it exists for one
// reason: the deflection rate is the point of the whole exercise, and "of the
// people who opened an article, how many escaped anyway" cannot be answered
// from totals alone. It ties events within one visit together and identifies
// nobody outside it.
//
// The nullable columns are filled per type — see TroubleshootingEventType.
// One table with nullable columns rather than four tables because these are
// read together, and every query worth writing spans more than one type.
model TroubleshootingEvent {
  id         Int                      @id @default(autoincrement())
  type       TroubleshootingEventType

  /// Random per-visit value. Not a user id and not stable across visits.
  sessionId  String

  /// Which subject's library — a device key or an application key. Null for
  /// a search made before a subject resolved.
  subjectKey String?
  /// The symptom an article belongs to. Null for SEARCH_NO_MATCH.
  symptomId  String?
  /// 1-based. STEP_REACHED only.
  stepNumber Int?
  /// The search text that returned nothing. SEARCH_NO_MATCH only — this is
  /// the most actionable column in the table, since it is users naming the
  /// articles that should be written next, in their own words.
  query      String?

  /// Qualifier for the event. ESCAPE_TAKEN only, recording which control was
  /// used: "nothing_worked" or "teams_call". Both mean the article failed
  /// them, but one is a person reaching for the phone and the other is a
  /// person giving up on the page, and the mix is worth being able to see.
  detail     String?

  createdAt  DateTime                 @default(now())

  /// The settings card groups by type and orders by recency; the retention
  /// sweep deletes by createdAt.
  @@index([type, createdAt])
  @@index([createdAt])
}

/// ARTICLE_OPENED   an article page was reached (subjectKey + symptomId)
/// STEP_REACHED     a step scrolled into view (subjectKey + symptomId + stepNumber)
/// ESCAPE_TAKEN     an escape control was used (subjectKey + symptomId? + detail)
/// SEARCH_NO_MATCH  a symptom search returned nothing (query + subjectKey?)
enum TroubleshootingEventType {
  ARTICLE_OPENED
  STEP_REACHED
  ESCAPE_TAKEN
  SEARCH_NO_MATCH
}

/// ─────────────────────────────────────────────────────────────────────────
///  TROUBLESHOOTING CONTENT
/// ─────────────────────────────────────────────────────────────────────────
///
/// The article library, moved off disk so admins can edit it in the UI.
///
/// The `.ts` modules under src/content/troubleshooting stay in the tree as
/// the SEED — a fresh database is built from them on first boot — but from
/// that point the rows are the truth and editing a module does nothing.
///
/// THE SHAPE IS DELIBERATELY MIXED. The taxonomy is normalised because it is
/// the part that gets ordered, filtered, counted and constrained. The article
/// body is a single validated JSON column because a step is only ever read as
/// part of its article and only ever written as part of one — normalising it
/// into step/figure/image/branch tables would buy no query anyone needs and
/// would turn publishing into a four-table duplication. `Setting.value` and
/// `BackgroundJob.payload` are already JSON columns; this is that precedent.

/// One row per subject in SUBJECT_KEYS. Names are NOT here — SUBJECT_LABELS
/// must be able to name a subject that has no content at all (the picker
/// renders those greyed), so a table of them would be a table of constants.
model TroubleshootingSubject {
  key        String   @id
  /// "device" | "app" — splits the picker into two sections.
  kind       String
  /// SUBJECT_KEYS order, frozen at seed.
  position   Int
  updatedAt  DateTime @updatedAt

  categories TroubleshootingCategory[]
  symptoms   TroubleshootingSymptom[]
}

model TroubleshootingCategory {
  id         Int      @id @default(autoincrement())
  subjectKey String
  /// URL-safe id, e.g. "power". Never edited — it is an analytics key.
  slug       String
  glyph      String
  name       String
  blurb      String
  position   Int

  /// Admin switch. A disabled category and its symptoms leave every listing,
  /// but their articles still serve at their own URLs — see the repository.
  /// Applied immediately, NOT through the article draft: disabling is almost
  /// always "this is wrong, get it off the site now".
  disabled   Boolean  @default(false)
  disabledAt DateTime?
  disabledBy String?

  updatedAt  DateTime @updatedAt

  subject    TroubleshootingSubject   @relation(fields: [subjectKey], references: [key], onDelete: Cascade)
  symptoms   TroubleshootingSymptom[]

  @@unique([subjectKey, slug])
  @@index([subjectKey, position])
}

model TroubleshootingSymptom {
  id         Int      @id @default(autoincrement())
  /// Denormalised from the category ON PURPOSE. Symptom ids are unique within
  /// a SUBJECT, not within a category — content.test.ts asserts exactly that
  /// — and it is only expressible as a database constraint with the subject
  /// key on this row. Prisma cannot declare a unique across a relation.
  subjectKey String
  categoryId Int
  /// URL segment, branch target and analytics key. Never edited.
  slug       String
  /// The wording users read in the list and search against. Editable.
  label      String
  position   Int
  updatedAt  DateTime @updatedAt

  subject     TroubleshootingSubject          @relation(fields: [subjectKey], references: [key], onDelete: Cascade)
  category    TroubleshootingCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  memberships TroubleshootingArticleSubject[]

  @@unique([subjectKey, slug])
  @@index([categoryId, position])
}

/// One article, listed under one or more subjects.
///
/// DRAFT IS A SECOND COLUMN, NOT A SECOND ROW. With two rows and a `state`
/// filter, forgetting the filter once serves unpublished text to a user,
/// silently. Here the public path reads `body` and the editor reads
/// `draftBody`, so leaking a draft is not a bug that can be written. Publish
/// is `body = draftBody; draftBody = null`.
model TroubleshootingArticle {
  id             Int      @id @default(autoincrement())
  /// The symptom this answers. Mirrored onto the membership rows so the
  /// database can enforce one article per subject+symptom.
  symptomSlug    String

  /// The live document as JSON — everything in articleSchema except
  /// symptomId and subjectKeys, which are relational. Validated by
  /// articleBodySchema on write, on publish, and again when the snapshot
  /// loads.
  body           String

  /// Unpublished edits, same shape. NULL means no pending changes.
  draftBody      String?
  draftUpdatedAt DateTime?
  draftUpdatedBy String?

  /// Unlisted, not retracted. Gone from every listing, still served at its
  /// own URL — a link IT already sent somebody has to keep working. Applied
  /// immediately, like the category switch.
  hidden         Boolean  @default(false)
  hiddenAt       DateTime?
  hiddenBy       String?

  publishedAt    DateTime @default(now())
  publishedBy    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subjects       TroubleshootingArticleSubject[]
}

/// The article-to-subject join, carrying `symptomSlug` so two assertions that
/// content.test.ts makes by hand become database constraints instead:
/// the compound foreign key enforces "every article's symptom exists in every
/// subject it claims", and the unique enforces "at most one article per
/// subject and symptom" — the shadowing bug the test was written to catch.
model TroubleshootingArticleSubject {
  articleId   Int
  subjectKey  String
  symptomSlug String

  article TroubleshootingArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  symptom TroubleshootingSymptom @relation(fields: [subjectKey, symptomSlug], references: [subjectKey, slug], onDelete: Cascade)

  @@id([articleId, subjectKey])
  @@unique([subjectKey, symptomSlug])
}
