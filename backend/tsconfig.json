{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "../backend/src",
    "types": ["node"]
  },
  "include": ["src"],
  // Tests are excluded from the emit, not just ignored: the Dockerfile
  // compiles with plain `tsc` and then `--prod deploy`s, so a test file left
  // in dist/ would be shipped alongside a vitest import that isn't installed.
  "exclude": ["node_modules", "src/**/*.test.ts"]
}